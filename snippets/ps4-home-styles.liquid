{% doc %}
  Shared presentation for the editable PS4PETS homepage sections.
  @example
  {% render 'ps4-home-styles' %}
{% enddoc %}
{% stylesheet %}
  .ps4-home {
    background: var(--ps4-background, var(--color-background));
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    overflow-wrap: anywhere;
  }

  .ps4-home:not(.ps4-home--blocks) h1,
  .ps4-home:not(.ps4-home--blocks) h2,
  .ps4-home:not(.ps4-home--blocks) h3 {
    color: inherit;
    font-family: var(--ps4-heading-font, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
    letter-spacing: -0.035em;
    text-transform: none;
    margin: 0;
    white-space: pre-line;
    text-wrap: balance;
  }

  .ps4-home:not(.ps4-home--blocks) h2 { font-size: clamp(1.8rem, 3.2vw, 3rem); line-height: 1.08; }
  .ps4-home:not(.ps4-home--blocks) h3 { font-size: clamp(1.05rem, 1.5vw, 1.45rem); line-height: 1.2; }
  .ps4-home a { text-decoration: none; }
  .ps4-home a:focus-visible,
  .ps4-home input:focus-visible,
  .ps4-home button:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .ps4-home img,
  .ps4-home svg { display: block; max-inline-size: 100%; }
  .ps4-container { max-inline-size: var(--narrow-page-width); margin-inline: auto; padding-inline: clamp(18px, 3vw, 48px); }
  .ps4-copy { font-size: clamp(0.9rem, 1.1vw, 1.15rem); line-height: 1.55; }
  .ps4-copy p { margin-block: 0.7em; }
  .ps4-eyebrow { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.2em; font-weight: 600; margin-block: 0 1.2rem; }
  .ps4-home .ps4-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    min-block-size: 48px;
    background: var(--button-background-color);
    color: var(--button-color);
    border: var(--style-border-width-primary) solid var(--button-border-color);
    border-radius: var(--style-border-radius-buttons-primary, 16px);
    font: 600 0.8rem var(--font-body--family);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
  }
  .ps4-home .ps4-button--secondary {
    background: var(--color-secondary-button-background);
    color: var(--color-secondary-button-text);
    border-color: var(--color-secondary-button-border);
  }
  .ps4-button:hover { opacity: 0.85; }
  .ps4-paw { color: var(--color-accent, currentColor); font: 2rem Georgia, serif; }
  .ps4-cards {
    padding-block: var(--ps4-cards-padding-start, 22px) var(--ps4-cards-padding-end, 32px);
  }
  .ps4-section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-block-end: 20px; }
  .ps4-section-heading--center {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
    align-items: center;
    text-align: center;
  }
  .ps4-section-heading--center > h2 {
    grid-column: 2;
    grid-row: 1;
    min-inline-size: 0;
  }
  .ps4-section-heading--center > a,
  .ps4-section-heading--center > .ps4-section-heading__actions {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    min-inline-size: 0;
    max-inline-size: 100%;
    text-align: end;
  }
  .ps4-section-heading--right { flex-direction: column; align-items: flex-end; text-align: end; }
  .ps4-section-heading__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: var(--gap-3xl);
    min-inline-size: 0;
    max-inline-size: 100%;
    margin-inline-start: auto;
  }
  .ps4-section-heading__actions a {
    font-weight: 700;
  }
  .ps4-section-heading__text { min-inline-size: 0; font-size: 0.85rem; }
  .ps4-section-heading a { font-size: 0.85rem; padding-block: 12px; }
  .ps4-section-heading a span { margin-inline-start: 12px; }
  .ps4-card-grid { display: grid; gap: 18px; }
  .ps4-card { min-inline-size: 0; background: var(--ps4-card-background, transparent); border-radius: var(--style-border-radius-lg); overflow: hidden; padding-block: var(--ps4-cards-padding-start)}
  .ps4-card__link { display: block; block-size: 100%; }
  .ps4-card__image { aspect-ratio: 1; background: var(--color-background); overflow: hidden; border-radius: var(--style-border-radius-lg); }
  .ps4-card__image img,
  .ps4-card__image svg { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .ps4-cards--category .ps4-card-grid { grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .ps4-cards--category .ps4-card__body { padding: 10px 3px; text-align: center; }
  .ps4-cards--category h3 { font-size: clamp(0.85rem, 1.25vw, 1.2rem); }
  .ps4-cards--benefit { padding-block: var(--ps4-cards-padding-start, 28px) var(--ps4-cards-padding-end, 28px); background-color: #f2f1Ea; border-radius: 25px;}
  .ps4-cards--benefit .ps4-card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ps4-cards--benefit .ps4-card { display: flex; flex-direction: column; gap: 20px; align-items: center; text-align: center; border-inline-end: 1px solid var(--color-border); border-radius: 0; padding-inline-end: 12px; }
  .ps4-cards--benefit .ps4-card:last-child { border: 0; }
  .ps4-cards--benefit h3 { font-size: 1.1rem; }
  .ps4-cards--benefit .ps4-copy { font-size: 0.85rem; }
  .ps4-cards--benefit .ps4-card__link { display: flex; flex-direction: column; align-items: center; gap: inherit; min-inline-size: 0; inline-size: 100%; block-size: auto; }
  .ps4-symbol { font: 3.5rem Georgia, serif; flex-shrink: 0; }
  .ps4-symbol--image { display: block; inline-size: 1em; block-size: 1em; }
  .ps4-symbol--image img { inline-size: 100%; block-size: 100%; object-fit: contain; }
  .ps4-feature { display: grid; grid-template-columns: 44% 1fr; padding-inline: 0; }
  .ps4-feature__image { min-inline-size: 0; min-block-size: 360px; }
  .ps4-feature__image img,
  .ps4-feature__image svg { inline-size: 100%; block-size: 100%; max-block-size: 520px; object-fit: cover; }
  .ps4-feature__body { padding: clamp(26px, 4vw, 64px); align-self: center; }
  .ps4-feature__body .ps4-paw { float: inline-end; }
  .ps4-cards--promo .ps4-card-grid { grid-template-columns: 1.2fr 1fr; }
  .ps4-cards--promo .ps4-card { position: relative; min-block-size: 350px; }
  .ps4-cards--promo .ps4-card__body { position: relative; padding: clamp(24px, 3vw, 48px); }
  .ps4-cards--promo h3 { font-size: clamp(1.8rem, 3vw, 2.8rem); }
  .ps4-cards--promo .ps4-card__image { position: absolute; inset-block-end: 0; inset-inline-end: 0; inline-size: 38%; opacity: 0.3; }
  .ps4-cards--promo .ps4-placeholder { display: none; }
  .ps4-card__cta { display: inline-flex; align-items: center; gap: 20px; margin-block-start: 14px; font-weight: 600; }
  .ps4-cards--journal .ps4-card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ps4-cards--journal .ps4-card__content { position: relative; display: grid; grid-template-columns: minmax(0, 42%) minmax(0, 1fr); gap: 16px; block-size: 100%; padding: 10px 10px 45px; border: 1px solid var(--color-border); border-radius: var(--style-border-radius-lg); }
  .ps4-card__arrow {
    position: absolute;
    inset-block-end: 10px;
    inset-inline-end: 10px;
    display: grid;
    place-items: center;
    inline-size: 30px;
    block-size: 30px;
    border-radius: 50%;
    background: var(--color-secondary-button-background);
    color: var(--color-secondary-button-text);
  }
  .ps4-card__arrow::before,
  .ps4-card__arrow::after { content: ''; grid-area: 1 / 1; }
  .ps4-card__arrow::before { inline-size: 11px; border-block-start: 2px solid currentColor; }
  .ps4-card__arrow::after {
    inline-size: 7px;
    block-size: 7px;
    border-block-start: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
    transform: translateX(2px) rotate(45deg);
  }
  .ps4-card__arrow:dir(rtl)::after { transform: translateX(-2px) rotate(-45deg); }
  .ps4-card__arrow:hover { background: var(--color-secondary-button-hover-background); color: var(--color-secondary-button-hover-text); }
  .ps4-card__arrow:focus-visible { outline-color: var(--color-foreground); outline-offset: 3px; }
  .ps4-cards--journal .ps4-card__image { aspect-ratio: 1; min-block-size: 180px; }
  .ps4-cards--journal .ps4-card__body { align-self: center; }
  .ps4-cards--journal .ps4-copy { font-size: 0.85rem; }
  .ps4-newsletter { display: grid; grid-template-columns: 1.1fr 1fr; gap: 30px; align-items: center; padding-block: 28px; }
  .ps4-newsletter__intro {
    display: flex;
    align-items: center;
    gap: var(--gap-xl);
    min-inline-size: 0;
  }
  .ps4-newsletter__icon {
    flex-shrink: 0;
    inline-size: clamp(40px, 5vw, 64px);
    block-size: auto;
  }
  .ps4-newsletter__text { min-inline-size: 0; }
  .ps4-newsletter h2 { font-size: clamp(1.6rem, 2.3vw, 2.3rem); }
  .ps4-newsletter .ps4-copy { font-size: 0.85rem; }
  .ps4-newsletter__fields { display: flex; gap: 12px; }
  .ps4-home .ps4-newsletter__fields .ps4-button {
    border-radius: 25px;
    padding: 10px 32px;
  }
  .ps4-newsletter input { min-inline-size: 0; inline-size: 100%; border: 1px solid var(--color-input-border); border-radius: var(--style-border-radius-inputs); background: var(--color-input-background); color: var(--color-input-text); padding: 14px 20px; }
  .ps4-newsletter__form { min-inline-size: 0; }
  .ps4-newsletter button { flex-shrink: 0; }
  @media (max-width: 989px) {
    .ps4-cards--category .ps4-card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .ps4-cards--journal .ps4-card-grid { grid-template-columns: 1fr; }
    .ps4-cards--journal .ps4-card__image { max-block-size: 220px; }
    .ps4-cards--benefit .ps4-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ps4-newsletter { grid-template-columns: 1fr; }
  }
  @media (max-width: 749px) {
    .ps4-cards {
      padding-block: var(--ps4-cards-padding-start-mobile, var(--ps4-cards-padding-start, 22px)) var(--ps4-cards-padding-end-mobile, var(--ps4-cards-padding-end, 32px));
    }
    .ps4-section-heading { flex-wrap: wrap; gap: 4px; }
    .ps4-cards--category .ps4-section-heading {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--gap-sm);
      text-align: start;
    }

    .ps4-home .ps4-cards--category .ps4-section-heading > h2 {
      flex: 0 0 auto;
      min-inline-size: 0;
      font-size: 20px;
      white-space: nowrap;
      text-wrap: nowrap;
      text-align: start;
    }

    .ps4-cards--category .ps4-section-heading > a,
    .ps4-cards--category .ps4-section-heading__actions {
      flex: 0 1 auto;
      min-inline-size: 0;
      inline-size: auto;
      margin-inline-start: auto;
      text-align: end;
    }

    .ps4-cards--category .ps4-section-heading a {
      font-size: 0.85rem;
      white-space: normal;
      text-wrap: pretty;
    }

    .ps4-cards--category .ps4-section-heading a span {
      margin-inline-start: var(--gap-2xs);
    }
    .ps4-feature,
    .ps4-cards--promo .ps4-card-grid { grid-template-columns: 1fr; }
    .ps4-feature__image { min-block-size: 0; aspect-ratio: 1.3; }
    .ps4-feature__image img { max-block-size: none; }
    .ps4-cards--category .ps4-card-grid {
      --ps4-mobile-card-gap: 12px;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: var(--ps4-mobile-card-width, 160px);
      gap: var(--ps4-mobile-card-gap);
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 0;
      padding: 4px;
    }

    .ps4-cards--category .ps4-card-grid::-webkit-scrollbar {
      display: none;
    }

    .ps4-cards--category .ps4-card-grid > .ps4-card {
      scroll-snap-align: start;
    }

    .ps4-cards--category .ps4-card-grid:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }
    .ps4-cards--benefit .ps4-card { gap: 10px; border: 0; }
    .ps4-symbol { font-size: 2.3rem; }
    .ps4-cards--benefit h3 { font-size: 1rem; }
    .ps4-newsletter__fields { flex-direction: column; }
  }
{% endstylesheet %}
