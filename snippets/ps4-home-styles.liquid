{% doc %}
  Shared presentation for the editable PS4PETS homepage sections.
  @example
  {% render 'ps4-home-styles' %}
{% enddoc %}
{% stylesheet %}
  .ps4-home {
    background: var(--ps4-background, var(--color-background));
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    overflow-wrap: anywhere;
  }

  .ps4-home h1,
  .ps4-home h2,
  .ps4-home h3 {
    color: inherit;
    font-family: var(--ps4-heading-font, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
    letter-spacing: -0.035em;
    text-transform: none;
    margin: 0;
    white-space: pre-line;
    text-wrap: balance;
  }

  .ps4-home h2 { font-size: clamp(1.8rem, 3.2vw, 3rem); line-height: 1.08; }
  .ps4-home h3 { font-size: clamp(1.05rem, 1.5vw, 1.45rem); line-height: 1.2; }
  .ps4-home a { color: inherit; text-decoration: none; }
  .ps4-home a:focus-visible,
  .ps4-home input:focus-visible,
  .ps4-home button:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .ps4-home img,
  .ps4-home svg { display: block; max-inline-size: 100%; }
  .ps4-container { max-inline-size: var(--narrow-page-width); margin-inline: auto; padding-inline: clamp(18px, 3vw, 48px); }
  .ps4-copy { font-size: clamp(0.9rem, 1.1vw, 1.15rem); line-height: 1.55; }
  .ps4-copy p { margin-block: 0.7em; }
  .ps4-eyebrow { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.2em; font-weight: 600; margin-block: 0 1.2rem; }
  .ps4-home .ps4-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    min-block-size: 48px;
    padding: 13px 30px;
    background: var(--button-background-color);
    color: var(--button-color);
    border: var(--style-border-width-primary) solid var(--button-border-color);
    border-radius: var(--style-border-radius-buttons-primary, 16px);
    font: 600 0.8rem var(--font-body--family);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
  }
  .ps4-home .ps4-button--secondary {
    background: var(--color-secondary-button-background);
    color: var(--color-secondary-button-text);
    border-color: var(--color-secondary-button-border);
  }
  .ps4-button:hover { opacity: 0.85; }
  .ps4-heart { color: var(--color-accent, currentColor); font: 3rem Georgia, serif; }
  .ps4-hero { position: relative; isolation: isolate; min-block-size: var(--ps4-hero-height); display: grid; align-items: center; }
  .ps4-hero__media { position: absolute; inset: 0; inset-inline-start: 24%; z-index: -2; }
  .ps4-hero__media img { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: var(--ps4-position); }
  .ps4-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to right, var(--ps4-background) 0%, var(--ps4-background) 25%, transparent 68%); }
  [dir='rtl'] .ps4-hero::after { background: linear-gradient(to left, var(--ps4-background) 0%, var(--ps4-background) 25%, transparent 68%); }
  .ps4-hero__content { inline-size: min(58%, 850px); padding: clamp(28px, 5vw, 80px); }
  .ps4-hero h1 { font-size: clamp(2.4rem, 4.5vw, 5rem); line-height: 1; }
  .ps4-hero .ps4-copy { font-size: clamp(1rem, 1.4vw, 1.4rem); margin-block: 1rem 2rem; }
  .ps4-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-block-end: 1.3rem; }
  .ps4-hero__note { position: absolute; inset-inline-end: 6%; inset-block-start: 8%; background: var(--ps4-background); padding: 1rem 1.5rem; transform: rotate(-10deg); font: italic clamp(1rem, 1.7vw, 1.8rem) Georgia, serif; white-space: pre-line; text-align: center; }
  .ps4-cards { padding-block: 22px 32px; }
  .ps4-section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-block-end: 20px; }
  .ps4-section-heading a { font-size: 0.85rem; padding-block: 12px; }
  .ps4-section-heading a span { margin-inline-start: 12px; }
  .ps4-card-grid { display: grid; gap: 18px; }
  .ps4-card { min-inline-size: 0; background: var(--ps4-card-background, transparent); border-radius: var(--style-border-radius-lg); overflow: hidden; }
  .ps4-card__link { display: block; block-size: 100%; }
  .ps4-card__image { aspect-ratio: 1.12; background: var(--color-background); overflow: hidden; border-radius: var(--style-border-radius-lg); }
  .ps4-card__image img,
  .ps4-card__image svg { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .ps4-cards--category .ps4-card-grid { grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .ps4-cards--category .ps4-card__body { padding: 10px 3px; text-align: center; }
  .ps4-cards--category h3 { font-size: clamp(0.85rem, 1.25vw, 1.2rem); }
  .ps4-cards--benefit { padding-block: 28px; }
  .ps4-cards--benefit .ps4-card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ps4-cards--benefit .ps4-card { display: flex; gap: 20px; align-items: center; border-inline-end: 1px solid var(--color-border); border-radius: 0; padding-inline-end: 12px; }
  .ps4-cards--benefit .ps4-card:last-child { border: 0; }
  .ps4-cards--benefit h3 { font-size: 1.1rem; }
  .ps4-cards--benefit .ps4-copy { font-size: 0.85rem; }
  .ps4-symbol { font: 3.5rem Georgia, serif; flex-shrink: 0; }
  .ps4-feature { display: grid; grid-template-columns: 44% 1fr; padding-inline: 0; }
  .ps4-feature__image { min-inline-size: 0; min-block-size: 360px; }
  .ps4-feature__image img,
  .ps4-feature__image svg { inline-size: 100%; block-size: 100%; max-block-size: 520px; object-fit: cover; }
  .ps4-feature__body { padding: clamp(26px, 4vw, 64px); align-self: center; }
  .ps4-feature__body .ps4-heart { float: inline-end; }
  .ps4-cards--promo .ps4-card-grid { grid-template-columns: 1.2fr 1fr; }
  .ps4-cards--promo .ps4-card { position: relative; min-block-size: 350px; }
  .ps4-cards--promo .ps4-card__body { position: relative; padding: clamp(24px, 3vw, 48px); }
  .ps4-cards--promo h3 { font-size: clamp(1.8rem, 3vw, 2.8rem); }
  .ps4-cards--promo .ps4-card__image { position: absolute; inset-block-end: 0; inset-inline-end: 0; inline-size: 38%; opacity: 0.3; }
  .ps4-cards--promo .ps4-placeholder { display: none; }
  .ps4-card__cta { display: inline-flex; align-items: center; gap: 20px; margin-block-start: 14px; font-weight: 600; }
  .ps4-cards--journal .ps4-card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ps4-cards--journal .ps4-card__link { display: grid; grid-template-columns: 42% 1fr; gap: 16px; padding: 10px; border: 1px solid var(--color-border); border-radius: var(--style-border-radius-lg); }
  .ps4-cards--journal .ps4-card__image { aspect-ratio: auto; min-block-size: 180px; }
  .ps4-cards--journal .ps4-card__body { align-self: center; }
  .ps4-cards--journal .ps4-copy { font-size: 0.85rem; }
  .ps4-newsletter { display: grid; grid-template-columns: 1.1fr 1fr; gap: 30px; align-items: center; padding-block: 28px; }
  .ps4-newsletter h2 { font-size: clamp(1.6rem, 2.3vw, 2.3rem); }
  .ps4-newsletter .ps4-copy { font-size: 0.85rem; }
  .ps4-newsletter__fields { display: flex; gap: 12px; }
  .ps4-newsletter input { min-inline-size: 0; inline-size: 100%; border: 1px solid var(--color-input-border); border-radius: var(--style-border-radius-inputs); background: var(--color-input-background); color: var(--color-input-text); padding: 14px 20px; }
  .ps4-newsletter__form { min-inline-size: 0; }
  .ps4-newsletter button { flex-shrink: 0; }
  @media (max-width: 989px) {
    .ps4-cards--category .ps4-card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .ps4-cards--journal .ps4-card-grid { grid-template-columns: 1fr; }
    .ps4-cards--journal .ps4-card__image { max-block-size: 220px; }
    .ps4-cards--benefit .ps4-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ps4-newsletter { grid-template-columns: 1fr; }
  }
  @media (max-width: 749px) {
    .ps4-hero { display: flex; flex-direction: column; min-block-size: auto; }
    .ps4-hero__media { position: relative; inset: auto; inline-size: 100%; order: 1; aspect-ratio: 1.5; }
    .ps4-hero::after { display: none; }
    .ps4-hero__content { inline-size: 100%; padding: 32px 22px 24px; }
    .ps4-hero h1 { font-size: clamp(2.25rem, 8vw, 3.6rem); }
    .ps4-hero__note { display: none; }
    .ps4-actions { gap: 10px; }
    .ps4-actions .ps4-button { flex: 1; padding-inline: 15px; }
    .ps4-section-heading { flex-wrap: wrap; gap: 4px; }
    .ps4-feature,
    .ps4-cards--promo .ps4-card-grid { grid-template-columns: 1fr; }
    .ps4-feature__image { min-block-size: 0; aspect-ratio: 1.3; }
    .ps4-feature__image img { max-block-size: none; }
    .ps4-cards--category .ps4-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .ps4-cards--benefit .ps4-card { gap: 10px; border: 0; }
    .ps4-symbol { font-size: 2.3rem; }
    .ps4-cards--benefit h3 { font-size: 1rem; }
    .ps4-newsletter__fields { flex-direction: column; }
  }
{% endstylesheet %}
