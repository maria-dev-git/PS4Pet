{%- doc -%}
  Renders a wrapper section

  @param {section} section - The section object
  @param {string} children - The children of the section
  @param {string} section_id - The ID of the section
  @param {string} background_color - The background color of the section
{%- enddoc -%}

{% liquid
  assign skip_contrast = false
  if section.settings.background_media != blank and section.settings.background_media != 'none'
    assign skip_contrast = true
  endif
%}
{% render 'contrast-override',
  background_color: background_color,
  section_id: section_id,
  skip_contrast: skip_contrast
%}

<div class="section-background color-custom-{{ section_id }}"></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.section_width_mobile == 'page-width' or section.settings.section_width_mobile == 'full-width' %} section--content-mobile-{{ section.settings.section_width_mobile }}{% endif %} color-custom-{{ section_id }}"
  data-testid="ui-test-section"

  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}

  style="
    {% if section.settings.section_height == 'custom' %}
      --section-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --section-min-height: 100svh;
    {% elsif section.settings.section_height != '' %}
      --section-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}

    {% if section.settings.section_height != '' %}
     --section-preview-height: 600px;
     {% endif %}
  "
>
  <div class="custom-section-background">
    {% render 'background-media',
      background_media: section.settings.background_media,
      background_video: section.settings.video,
      background_video_position: section.settings.video_position,
      background_image: section.settings.background_image,
      background_image_position: section.settings.background_image_position
    %}
  </div>

  <div
    class="border-style custom-section-content"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% if section.settings.toggle_overlay %}
      {% render 'overlay', settings: section.settings, layer: '0' %}
    {% endif %}

    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        section-content-wrapper
        {% if page.handle == 'our-mission' and section.id contains 'section_XfYrLp' %} section-content-wrapper--jules-family{% endif %}
        {% if section.settings.mobile_icons_beside_text %} section-content-wrapper--mobile-inline-icons{% endif %}
        {% if section.settings.content_direction == 'row' and section.settings.mobile_columns == '2' and section.settings.three_part_layout != true %} section-content-wrapper--mobile-two-columns{% endif %}
        {% if section.settings.three_part_layout %} section-content-wrapper--image-text-art{% endif %}
        {% if section.settings.three_part_layout and section.settings.pixel_image_layout %} section-content-wrapper--pixel-image-art{% endif %}
        {% if section.settings.show_right_image_mobile %} section-content-wrapper--mobile-right-art{% endif %}
        {% if section.settings.item_dividers %} section-content-wrapper--item-dividers{% endif %}
        {% if section.settings.vertical_on_mobile %} mobile-column{% endif %}
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
        --item-divider-color: {{ section.settings.item_divider_color | default: 'var(--color-border)' }};
        --item-divider-offset: calc({{ section.settings.gap }}px / -2);
        --section-left-image-width: {{ section.settings.left_image_width }}%;
        --section-right-image-width: {{ section.settings.right_image_width }}%;
        {% if section.settings.three_part_layout and section.settings.pixel_image_layout %}
          --section-left-image-width: {{ section.settings.left_image_width_px }}px;
          --section-right-image-width: {{ section.settings.right_image_width_px }}px;
          --section-padding-inline-desktop: {{ section.settings.padding_inline_desktop | default: 0 }}px;
          --section-padding-inline-mobile: {{ section.settings.padding_inline_mobile | default: 0 }}px;
          {% if section.settings.show_right_image_mobile %}
            --section-padding-block-start-mobile: {{ section.settings.padding_block_start_mobile }}px;
            --section-padding-block-end-mobile: {{ section.settings.padding_block_end_mobile }}px;
          {% endif %}
        {% endif %}
      "
      data-testid="section-content"
    >
      {% capture right_art %}
      {% if section.settings.three_part_layout and section.settings.right_image != blank %}
        {% assign right_image_sizes = section.settings.right_image_width | append: 'vw' %}
        {% if section.settings.pixel_image_layout %}
          {% assign right_image_sizes = section.settings.right_image_width_px | append: 'px' %}
        {% endif %}
        <div class="section-content-wrapper__art">
          {{ section.settings.right_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '120, 240, 400, 600, 800', sizes: right_image_sizes }}
        </div>
      {% endif %}
      {% endcapture %}
      {% if section.settings.pixel_image_layout and section.settings.show_right_image_mobile %}
        {{ right_art }}
      {% endif %}
      {{ children }}
      {% unless section.settings.pixel_image_layout and section.settings.show_right_image_mobile %}
        {{ right_art }}
      {% endunless %}
    </div>
  </div>
</div>

{% stylesheet %}
  @media screen and (max-width: 749px) {
    .section-content-wrapper--jules-family > .section-content-wrapper__art {
      display: none;
    }

    .section-content-wrapper--mobile-inline-icons > .group-block > .group-block-content {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: var(--gap-lg);
    }

    .section-content-wrapper--mobile-inline-icons > .group-block > .group-block-content > .group-block {
      min-inline-size: 0;
      inline-size: 100%;
    }

    .section-content-wrapper--mobile-inline-icons > .group-block .text-block > * {
      text-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    .section--content-mobile-page-width > .custom-section-content {
      grid-column: 2;
    }

    .section--content-mobile-full-width > .custom-section-content {
      grid-column: 1 / -1;
    }
  }

  .section-content-wrapper--image-text-art {
    display: grid;
    grid-template-columns: minmax(0, var(--section-left-image-width)) minmax(0, 1fr);
    align-items: center;
  }

  .section-content-wrapper--image-text-art:has(> .section-content-wrapper__art) {
    grid-template-columns: minmax(0, var(--section-left-image-width)) minmax(0, 1fr) minmax(0, var(--section-right-image-width));
  }

  .section-content-wrapper--image-text-art > :is(.image-block, .group-block) {
    min-width: 0;
    width: 100%;
  }

  .section-content-wrapper__art img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .section-content-wrapper--image-text-art,
    .section-content-wrapper--image-text-art:has(> .section-content-wrapper__art) {
      grid-template-columns: minmax(0, 1fr);
    }

    .section-content-wrapper__art {
      width: var(--section-right-image-width);
      justify-self: end;
    }
  }

  /* Pixel sizing is opt-in; existing percentage layouts retain their behavior. */
  .section-content-wrapper--pixel-image-art {
    padding-inline: var(--section-padding-inline-desktop);
  }

  .section-content-wrapper--pixel-image-art > .image-block,
  .section-content-wrapper--pixel-image-art > .section-content-wrapper__art {
    overflow: hidden;
    min-inline-size: 0;
  }

  @media screen and (min-width: 750px) {
    /* Keep each role in its column even when the editor omits a hidden block. */
    .section-content-wrapper--pixel-image-art,
    .section-content-wrapper--pixel-image-art:has(> .section-content-wrapper__art) {
      grid-template-columns: minmax(0, var(--section-left-image-width)) minmax(0, 1fr) minmax(0, var(--section-right-image-width));
    }

    .section-content-wrapper--pixel-image-art > .image-block {
      grid-column: 1;
      grid-row: 1;
    }

    .section-content-wrapper--pixel-image-art > .group-block {
      grid-column: 2;
      grid-row: 1;
    }

    .section-content-wrapper--pixel-image-art > .section-content-wrapper__art {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media screen and (max-width: 749px) {
    .section-content-wrapper--pixel-image-art {
      padding-inline: var(--section-padding-inline-mobile);
    }

    .section-content-wrapper--pixel-image-art > .image-block,
    .section-content-wrapper--pixel-image-art > .section-content-wrapper__art {
      display: none;
    }

    .section-content-wrapper--pixel-image-art.section-content-wrapper--mobile-right-art {
      padding-block-start: var(--section-padding-block-start-mobile);
      padding-block-end: var(--section-padding-block-end-mobile);
    }

    .section-content-wrapper--pixel-image-art.section-content-wrapper--mobile-right-art > .section-content-wrapper__art {
      display: block;
      inline-size: min(100%, var(--section-right-image-width));
      justify-self: center;
    }
  }

  .section-content-wrapper--item-dividers > .group-block {
    position: relative;
  }

  .section-content-wrapper--item-dividers > .group-block + .group-block::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--item-divider-offset);
    border-inline-start: 1px solid var(--item-divider-color);
    pointer-events: none;
  }

  .section-content-wrapper--item-dividers.layout-panel-flex--column > .group-block + .group-block::before {
    inset-block: var(--item-divider-offset) auto;
    inset-inline: 0;
    border-inline-start: 0;
    border-block-start: 1px solid var(--item-divider-color);
  }

  @media screen and (max-width: 749px) {
    .section-content-wrapper--item-dividers.mobile-column > .group-block + .group-block::before {
      inset-block: var(--item-divider-offset) auto;
      inset-inline: 0;
      border-inline-start: 0;
      border-block-start: 1px solid var(--item-divider-color);
    }
  }

  @media screen and (max-width: 749px) {
    .section-content-wrapper--mobile-two-columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }

    .section-content-wrapper--mobile-two-columns > .group-block {
      min-width: 0;
      width: 100%;
    }

    .section-content-wrapper--mobile-two-columns.section-content-wrapper--item-dividers
      > .group-block + .group-block::before {
      content: none;
    }
  }

  .section-wrapper {
    --section-height-offset: 0px;
  }

  .section[data-shopify-visual-preview] {
    min-height: var(--section-preview-height);
    padding-top: 0;
  }

  .section[data-shopify-visual-preview] .custom-section-background {
    display: none;
  }

  body:has(#header-group > .header-section > #header-component[transparent]):not(
      :has(#header-group > .header-section + .shopify-section)
    )
    #MainContent
    > .section-wrapper:first-child {
    --section-height-offset: var(--header-group-height, 0);
  }

  .custom-section-background {
    grid-column: 1 / -1;
  }

  .custom-section-content {
    z-index: var(--layer-flat);
  }
{% endstylesheet %}
