{% comment %}Section contract: editable journal articles. Configure on the Jules Journal blog template.{% endcomment %}
{% assign journal = section.settings.blog | default: blog %}
<div class="section section--page-width journal-surface"><div class="journal-articles" style="--journal-columns:{{ section.settings.columns }};--journal-gap:{{ section.settings.gap }}px;--journal-radius:{{ section.settings.radius }}px;">
{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
{% paginate journal.articles by section.settings.count %}
<div class="journal-grid">{% for article in journal.articles %}
<article class="journal-card"><a href="{{ article.url }}">
{% if article.image %}{{ article.image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(max-width: 749px) calc(100vw - 32px), 50vw', loading: 'lazy' }}{% endif %}
<div class="journal-card__body">{% if article.tags.first %}<span>{{ article.tags.first | escape }}</span>{% endif %}
<h3>{{ article.title | escape }}</h3>
{% if section.settings.excerpt %}<p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 | escape }}</p>{% endif %}
{% if section.settings.date %}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>{% endif %}
</div></a></article>{% endfor %}</div>
{% if paginate.pages > 1 %}{{ paginate | default_pagination }}{% endif %}{% endpaginate %}
</div></div>
{% render 'section-color-scheme', section: section %}
{% stylesheet %}
.journal-surface:has(> .journal-articles) { background-color:var(--color-background); color:var(--color-foreground); }
.journal-articles { padding-block:24px; }
.journal-grid { display:grid; grid-template-columns:repeat(var(--journal-columns),minmax(0,1fr)); gap:var(--journal-gap); }
.journal-card { min-inline-size:0; overflow:hidden; border:1px solid var(--color-border); border-radius:var(--journal-radius); }
.journal-card a { display:block; color:inherit; text-decoration:none; }
.journal-card img { width:100%; height:auto; aspect-ratio:2.4; object-fit:cover; }
.journal-card__body { padding:18px; overflow-wrap:anywhere; }
.journal-card__body h3 { margin-block:10px; }
.journal-card__body span,.journal-card time { font-size:.8rem; }
@media(max-width:749px) { .journal-grid { grid-template-columns:minmax(0,1fr); } }
{% endstylesheet %}
{% schema %}
{
  "name": "t:journal.articles",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "t:journal.blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:journal.heading",
      "default": "Latest from the Journal"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:journal.columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:journal.gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:journal.radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "count",
      "label": "t:journal.count",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "date",
      "label": "t:journal.date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "excerpt",
      "label": "t:journal.excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "t:settings.use_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.use_color_scheme }}"
    }
  ],
  "presets": [
    {
      "name": "t:journal.articles"
    }
  ]
}
{% endschema %}
