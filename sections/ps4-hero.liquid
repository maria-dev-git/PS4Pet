{% comment %}
  Editable PS4PETS homepage region. Images selected in the editor replace bundled artwork.
  @example Add this section through the homepage theme editor.
{% endcomment %}
{% render 'ps4-home-styles' %}
{% render 'contrast-override', background_color: section.settings.background, section_id: section.id %}
<section class="ps4-home color-custom-{{ section.id }}" style="--ps4-background: {{ section.settings.background }}; --ps4-heading-font: {% if section.settings.heading_style == 'theme' %}var(--font-heading--family){% else %}Georgia, 'Times New Roman', serif{% endif %};"><div class="ps4-hero" style="--ps4-hero-height: {{ section.settings.height }}px; --ps4-position: {{ section.settings.position }};">
<div class="ps4-hero__media">{% render 'ps4-home-image', image: section.settings.image, asset: 'hero', alt: section.settings.image_alt, eager: true %}</div>
<div class="ps4-hero__content"><h1>{{ section.settings.heading | escape | newline_to_br }}</h1><div class="ps4-copy">{{ section.settings.text }}</div><div class="ps4-actions">{% if section.settings.label != blank and section.settings.link != blank %}<a class="ps4-button button" href="{{ section.settings.link }}">{{ section.settings.label | escape }} <span aria-hidden="true">→</span></a>{% endif %}{% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a class="ps4-button ps4-button--secondary button-secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div><p class="ps4-eyebrow">{{ section.settings.tagline | escape }} <span class="ps4-heart" aria-hidden="true">♡</span></p></div>{% if section.settings.note != blank %}<p class="ps4-hero__note">{{ section.settings.note | escape | newline_to_br }}</p>{% endif %}</div></section>
{% schema %}
{
  "name": "t:ps4.hero",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:ps4.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:ps4.text"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:ps4.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:ps4.link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:ps4.background",
      "default": "#fbf7f3"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:ps4.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:ps4.image_alt"
    },
    {
      "type": "select",
      "id": "asset",
      "label": "t:ps4.asset",
      "options": [
        {
          "value": "none",
          "label": "t:ps4.none"
        },
        {
          "value": "hero",
          "label": "t:ps4.hero_asset"
        },
        {
          "value": "jules",
          "label": "t:ps4.jules_asset"
        },
        {
          "value": "collar",
          "label": "t:ps4.collar_asset"
        },
        {
          "value": "toy",
          "label": "t:ps4.toy_asset"
        },
        {
          "value": "pouch",
          "label": "t:ps4.pouch_asset"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:ps4.secondary_label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:ps4.secondary_link"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "t:ps4.tagline"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "t:ps4.note"
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:ps4.height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:ps4.position",
      "options": [
        {
          "value": "left",
          "label": "t:ps4.left"
        },
        {
          "value": "center",
          "label": "t:ps4.center"
        },
        {
          "value": "right",
          "label": "t:ps4.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "t:ps4.heading_style",
      "options": [
        {
          "value": "serif",
          "label": "t:ps4.serif"
        },
        {
          "value": "theme",
          "label": "t:ps4.theme"
        }
      ],
      "default": "serif"
    }
  ],
  "presets": [
    {
      "name": "t:ps4.hero",
      "settings": {
        "heading": "Everything They Need. More Love With Every Order.",
        "text": "<p>For Pets. For Families. For Those Still Waiting for Theirs.</p>",
        "label": "Shop dogs",
        "link": "/collections/all",
        "secondary_label": "Shop cats",
        "secondary_link": "/collections/all"
      }
    }
  ]
}
{% endschema %}
