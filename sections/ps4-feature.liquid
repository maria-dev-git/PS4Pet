{% comment %}
  Editable PS4PETS homepage region. Images selected in the editor replace bundled artwork.
  @example Add this section through the homepage theme editor.
{% endcomment %}
{% render 'ps4-home-styles' %}
{% render 'contrast-override', background_color: section.settings.background, section_id: section.id %}
<section class="ps4-home color-custom-{{ section.id }}" style="--ps4-background: {{ section.settings.background }}; --ps4-heading-font: {% if section.settings.heading_style == 'theme' %}var(--font-heading--family){% else %}Georgia, 'Times New Roman', serif{% endif %};"><div class="ps4-container ps4-feature"><div class="ps4-feature__image">{% render 'ps4-home-image', image: section.settings.image, asset: section.settings.asset, alt: section.settings.image_alt %}</div><div class="ps4-feature__body{% if section.settings.use_content_blocks %} ps4-feature__body--blocks{% endif %}">
  {% if section.settings.use_content_blocks %}
    {% content_for 'block', type: '_content-without-appearance', id: 'content' %}
  {% else %}
{% if section.settings.eyebrow != blank %}<p class="ps4-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
<h2>{{ section.settings.heading | escape }}</h2>
{% if section.settings.text != blank %}<div class="ps4-copy">{{ section.settings.text }}</div>{% endif %}
{% if section.settings.label != blank and section.settings.link != blank %}<a class="ps4-button button" href="{{ section.settings.link }}">{{ section.settings.label | escape }} <span aria-hidden="true">→</span></a>{% endif %}<span class="ps4-paw" aria-hidden="true">🐾</span>
  {% endif %}
</div></div></section>
{% render 'section-color-scheme', section: section %}

{% schema %}
{
  "name": "t:ps4.feature",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_content_blocks",
      "label": "t:settings.use_content_blocks",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:ps4.eyebrow",
      "visible_if": "{{ section.settings.use_content_blocks == false }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:ps4.heading",
      "visible_if": "{{ section.settings.use_content_blocks == false }}"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:ps4.text",
      "visible_if": "{{ section.settings.use_content_blocks == false }}"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:ps4.label",
      "visible_if": "{{ section.settings.use_content_blocks == false }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:ps4.link",
      "visible_if": "{{ section.settings.use_content_blocks == false }}"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:ps4.background",
      "default": "#fbf7f3"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:ps4.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:ps4.image_alt"
    },
    {
      "type": "select",
      "id": "asset",
      "label": "t:ps4.asset",
      "options": [
        {
          "value": "none",
          "label": "t:ps4.none"
        },
        {
          "value": "hero",
          "label": "t:ps4.hero_asset"
        },
        {
          "value": "jules",
          "label": "t:ps4.jules_asset"
        },
        {
          "value": "collar",
          "label": "t:ps4.collar_asset"
        },
        {
          "value": "toy",
          "label": "t:ps4.toy_asset"
        },
        {
          "value": "pouch",
          "label": "t:ps4.pouch_asset"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "t:ps4.heading_style",
      "options": [
        {
          "value": "serif",
          "label": "t:ps4.serif"
        },
        {
          "value": "theme",
          "label": "t:ps4.theme"
        }
      ],
      "default": "serif"
    },
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "t:settings.use_color_scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.use_color_scheme }}"
    }
  ],
  "presets": [
    {
      "name": "t:ps4.feature",
      "settings": {
        "heading": "Jules - Rescue. Family. Forever.",
        "asset": "jules",
        "background": "#f7e6e1",
        "use_content_blocks": true
      },
      "blocks": {
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 18
          },
          "blocks": {
            "eyebrow": {
              "type": "text",
              "name": "t:names.caption",
              "settings": {
                "text": "<p>Meet Jules — the heart behind PS4PETS</p>",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "0.625rem",
                "case": "uppercase",
                "letter_spacing": "loose",
                "line_height": "normal",
                "width": "100%",
                "max_width": "none"
              }
            },
            "heading": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h2>Jules - Rescue. Family. Forever.</h2>",
                "type_preset": "h2",
                "width": "100%",
                "max_width": "none"
              }
            },
            "text": {
              "type": "text",
              "settings": {
                "text": "<p>Jules came into our family as a shelter pup and changed our lives forever.</p>",
                "type_preset": "rte",
                "width": "100%",
                "max_width": "none"
              }
            },
            "actions": {
              "type": "group",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": false,
                "horizontal_alignment": "space-between",
                "vertical_alignment": "center",
                "width": "fill",
                "width_mobile": "fill",
                "height": "fit",
                "gap": 16
              },
              "blocks": {
                "button": {
                  "type": "button",
                  "settings": {
                    "label": "Meet Jules",
                    "link": "/pages/meet-jules",
                    "style_class": "button",
                    "width": "fit-content",
                    "width_mobile": "fit-content"
                  }
                },
                "symbol": {
                  "type": "icon",
                  "settings": {
                    "icon": "paw_print",
                    "width": 48
                  }
                }
              },
              "block_order": [
                "button",
                "symbol"
              ]
            }
          },
          "block_order": [
            "eyebrow",
            "heading",
            "text",
            "actions"
          ]
        }
      }
    }
  ]
}
{% endschema %}
