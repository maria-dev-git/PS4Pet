{% # SRA target for /cart endpoints. The Section Rendering API provides the section wrapper. %}
{% render 'cart-drawer', render_wrapper: false %}

{% render 'section-color-scheme', section: section %}

{% schema %}
{
  "name": "t:names.cart_drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "t:settings.use_color_scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.use_color_scheme }}"
    }
  ]
}
{% endschema %}
