                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "answer"
              ]
            },
            "faq_pet_6": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What inspired PS4PETS?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "answer": {
                  "type": "text",
                  "settings": {
                    "text": "<p>PS4PETS was inspired by Jules, a rescue pit bull who became part of our family. Her story shaped our mission: support pets and the people who love them while helping shelter animals still waiting for their forever families. <a href=\"/pages/mission\">Read more about our mission.</a></p>",
                    "width": "100%",
                    "max_width": "normal",
