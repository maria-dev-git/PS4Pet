        "accordion_xKtrxX": {
          "type": "accordion",
          "name": "t:names.accordion",
          "settings": {
            "icon": "caret",
            "dividers": true,
            "divider_color": "",
            "type_preset": "h6",
            "background_color": "",
            "text_color": "",
            "border": "none",
