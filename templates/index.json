    "ps4_story": {
      "type": "ps4-feature",
      "settings": {
        "eyebrow": "Meet Jules — the heart behind PS4PETS",
        "heading": "Jules - Rescue. Family. Forever.",
        "text": "<p>Jules came into our family as a shelter pup and changed our lives forever. She’s a rescue pit bull, a baseball game regular, and the heart behind PS4PETS. Her story inspired our mission: give pets the things they need while helping shelter animals still waiting for their forever families.</p>",
        "label": "Meet Jules",
        "link": "/pages/meet-jules",
        "asset": "jules",
        "image_alt": "Jules, the rescue pup at the heart of PS4PETS",
        "background": "#f7e6e1"
      }
    },
