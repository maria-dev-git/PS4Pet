      "blocks": {
        "card_0": {
          "type": "card",
          "settings": {
            "heading": "Shop for yours.\nHelp one waiting for theirs.",
            "text": "<p>We believe every pet deserves someone in their corner. That’s why PS4PETS is built to support pets and the people who love them — while helping shelter animals still waiting for their Forever Families.</p><p>♡ Shop for yours. Help one waiting for theirs.</p><p>♡ Every pet deserves someone in their corner.</p><p>♡ For Pets. For Families. For Those Still Waiting for Theirs.</p>",
            "asset": "none",
            "link": "/pages/mission",
            "eyebrow": "Our mission",
            "label": "Our mission",
            "background": "#e5e9dc"
          }
        },
        "card_1": {
          "type": "card",
          "settings": {
            "heading": "Never Run Out\nof Their Favorites",
            "text": "<p>Set up easy auto-reorder for the essentials they always need — from food and treats to everyday must-haves. One less thing to worry about, more time for what matters.</p>",
            "asset": "pouch",
            "link": "/pages/auto-reorder",
            "eyebrow": "Auto-reorder",
            "label": "Learn more",
            "background": "#b9d9d7",
            "image_alt": "Green pet treat pouch"
          }
        }
      },
      "block_order": [
