          "blocks": {
            "text_qx3yW8": {
              "type": "text",
              "settings": {
                "text": "<p>PS4PETS isn’t supposed to be just another place that sells pet supplies.</p><p>We want it to be a place for people who consider their pets part of their family.</p><p>A place where buying the things your pet already needs can also help another animal who’s still sitting in a shelter waiting for their family to arrive.</p><p>That’s why we’re building ways for our customers to help shelters, donate rewards and supplies, share their own rescue stories, and become part of our PS4PETS family.</p><p>And I’ll be here too.</p><p>We’re calling it The Jules Journal.</p><p>I’ll share pictures, adventures, trips to the baseball field, rescue stories, and hopefully introduce you to some incredible animals who are still looking for their forever homes.</p><p>Because I know something about second chances.</p><p>I got mine.</p><p>Now we want to help more animals get theirs.</p><p>Welcome to our family.</p><p>Love,<br/>Jules</p><p></p>",
                "width": "100%",
                "max_width": "none",
