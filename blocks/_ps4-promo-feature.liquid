{% doc %}
  An editable promotion feature with a selected image or fallback icon above its text.
  @example
  {% content_for 'blocks' %} <!-- In a promotion card -->
{% enddoc %}
<div class="ps4-promo-feature" {{ block.shopify_attributes }}>
  {% if block.settings.image != blank %}
    {% assign image_alt = block.settings.image_alt | default: block.settings.image.alt | default: '' %}
    {{ block.settings.image | image_url: width: 144 | image_tag: widths: '48, 72, 96, 144', sizes: '56px', loading: 'lazy', alt: image_alt, class: 'ps4-promo-feature__image' }}
  {% elsif block.settings.icon != 'none' %}
    <svg class="ps4-promo-feature__image" width="56" height="56" viewBox="0 0 20 20" aria-hidden="true" focusable="false">{% render 'icon', icon: block.settings.icon %}</svg>
  {% endif %}
  {% if block.settings.text != blank %}<div class="ps4-promo-feature__text">{{ block.settings.text }}</div>{% endif %}
</div>
{% stylesheet %}
  .ps4-promo-feature { min-inline-size: 0; text-align: center; overflow-wrap: anywhere; }
  .ps4-promo-feature__image { inline-size: 56px; block-size: 56px; object-fit: contain; margin-inline: auto; margin-block-end: var(--margin-xs); fill: currentColor; }
  .ps4-promo-feature__text { font-family: var(--ps4-heading-font, var(--font-heading--family)); font-weight: var(--font-heading--weight); line-height: var(--font-paragraph--line-height); }
  .ps4-promo-feature__text p { margin: 0; }
{% endstylesheet %}
