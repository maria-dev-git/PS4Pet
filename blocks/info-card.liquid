{% doc %}
  Renders a compact image, heading, and rich-text card inside a merchant-managed group.
  Content and appearance are configured through block.settings.
  @example
  Add two Image with text blocks to a horizontal Group below Buy buttons.
{% enddoc %}

{% render 'contrast-override',
  background_color: block.settings.background_color,
  text_color: block.settings.text_color,
  section_id: block.id
%}

<div
  class="info-card{% if block.settings.background_color != blank or block.settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="--info-card-image-width: {{ block.settings.image_width }}px; --info-card-radius: {{ block.settings.corner_radius }}px; --info-card-padding: {{ block.settings.padding }}px; --info-card-heading-font: var(--font-{{ block.settings.heading_font }}--family); --info-card-heading-weight: var(--font-{{ block.settings.heading_font }}--weight); --info-card-heading-style: var(--font-{{ block.settings.heading_font }}--style); --info-card-heading-size: {{ block.settings.heading_size }}px; --info-card-body-font: var(--font-{{ block.settings.body_font }}--family); --info-card-body-weight: var(--font-{{ block.settings.body_font }}--weight); --info-card-body-style: var(--font-{{ block.settings.body_font }}--style); --info-card-body-size: {{ block.settings.body_size }}px;{% if block.settings.custom_padding %} --info-card-padding-top: {{ block.settings.padding_top }}px; --info-card-padding-bottom: {{ block.settings.padding_bottom }}px; --info-card-padding-start: {{ block.settings.padding_start }}px; --info-card-padding-end: {{ block.settings.padding_end }}px;{% endif %}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.image != blank %}
    {% assign image_sizes = block.settings.image_width | append: 'px' %}
    {{ block.settings.image
      | image_url: width: 240
      | image_tag:
        class: 'info-card__image',
        loading: 'lazy',
        widths: '32, 48, 64, 96, 160, 240',
        sizes: image_sizes
    }}
  {% endif %}
  {% if block.settings.heading != blank or block.settings.text != blank %}
    <div class="info-card__content">
      {% if block.settings.heading != blank %}
        <p class="info-card__heading">{{ block.settings.heading | escape }}</p>
      {% endif %}
      {% if block.settings.text != blank %}
        <div class="info-card__text rte">{{ block.settings.text }}</div>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .info-card {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-sm);
    flex: 1 1 0;
    min-width: 0;
    width: 100%;
    padding-block: var(--info-card-padding-top, var(--info-card-padding)) var(--info-card-padding-bottom, var(--info-card-padding));
    padding-inline: var(--info-card-padding-start, var(--info-card-padding)) var(--info-card-padding-end, var(--info-card-padding));
    border-radius: var(--info-card-radius);
    color: var(--color-foreground);
  }

  .info-card__image {
    flex: 0 1 var(--info-card-image-width);
    width: var(--info-card-image-width);
    max-width: 35%;
    height: auto;
    object-fit: contain;
  }

  .info-card__content {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .info-card__heading {
    margin: 0 0 var(--margin-2xs);
    font-family: var(--info-card-heading-font);
    font-weight: var(--info-card-heading-weight);
    font-style: var(--info-card-heading-style);
    font-size: var(--info-card-heading-size);
    line-height: 1.4;
  }

  .info-card__text {
    font-family: var(--info-card-body-font);
    font-weight: var(--info-card-body-weight);
    font-style: var(--info-card-body-style);
    font-size: var(--info-card-body-size);
    line-height: 1.5;
  }

  .info-card__text > :first-child {
    margin-block-start: 0;
  }

  .info-card__text > :last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image_with_text",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "t:settings.width",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:settings.padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "accent",
          "label": "t:options.accent"
        }
      ],
      "default": "subheading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:settings.size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "accent",
          "label": "t:options.accent"
        }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "t:settings.size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "checkbox",
      "id": "custom_padding",
      "label": "t:options.custom",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.custom_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.image_with_text",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
