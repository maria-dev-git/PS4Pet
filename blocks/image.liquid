{% doc %}
  Renders an image with optional pixel heights, tilt, frame and caption, or three story photos.
  @example
  {% content_for 'block', type: 'image', id: 'story-photos' %}
{% enddoc %}
{% liquid
  assign block_settings = block.settings
  assign ratio = 1
  assign has_photo_frame = false
  if block_settings.image_tilt != blank and block_settings.image_tilt != 0
    assign has_photo_frame = true
  endif
  if block_settings.white_border_width > 0 or block_settings.caption != blank
    assign has_photo_frame = true
  endif

  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'adapt'
      assign ratio = block_settings.image.aspect_ratio
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
%}

{% capture class %}
  image-block image-block--{{ block.id }} image-block--height-{{ block_settings.height }} spacing-style size-style
  {% unless block_settings.story_photo_pair %}
    {% if block_settings.image_height_desktop > 0 %} image-block--pixel-height-desktop{% endif %}
    {% if block_settings.image_height_mobile > 0 %} image-block--pixel-height-mobile{% endif %}
  {% endunless %}
{% endcapture %}

{% capture style %}
  --ratio: {{ ratio }};
  --image-block-tilt: {{ block_settings.image_tilt | default: 0 }}deg;
  --image-block-frame-width: {{ block_settings.white_border_width | default: 0 }}px;
  --image-block-frame-radius: {{ block_settings.border_radius }}px;
  --image-block-height-desktop: {{ block_settings.image_height_desktop | default: 0 }}px;
  --image-block-height-mobile: {{ block_settings.image_height_mobile | default: 0 }}px;
  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
{% endcapture %}

{% capture image_border_style %}
  --ratio: {{ ratio }};
  {% render 'border-override', settings: block_settings %}
{% endcapture %}

{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
%}

{% capture image %}
  {% if block_settings.story_photo_pair %}
    <div class="image-block__story-pair">
      {% for index in (1..3) %}
        {% liquid
          assign photo = block_settings.image
          assign caption = block_settings.caption
          if index == 2
            assign photo = block_settings.second_image
            assign caption = block_settings.second_caption
          elsif index == 3
            assign photo = block_settings.third_image
            assign caption = block_settings.third_caption
          endif
        %}
        {% if photo != blank or request.design_mode %}
          <figure class="image-block__story-photo">
            {% if photo != blank %}
              {{ photo | image_url: width: 1200 | image_tag: widths: '180, 320, 480, 750, 1000, 1200', sizes: '(min-width: 750px) 40vw, 85vw', loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            {% if caption != blank %}<figcaption>{{ caption | escape }}</figcaption>{% endif %}
          </figure>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
  {% capture single_image %}
  {%- if block_settings.image -%}
    {{
      block_settings.image
      | image_url: width: 3840
      | image_tag:
        width: block_settings.image.width,
        widths: widths,
        height: block_settings.image.height,
        class: 'image-block__image border-style',
        style: image_border_style,
        sizes: sizes
    }}
  {%- else -%}
    <div class="placeholder-image border-style size-style" style="{{ image_border_style }}">
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'image-block__placeholder' }}
    </div>
  {%- endif -%}
  {% endcapture %}
  {% if has_photo_frame %}
    <div class="image-block__photo-stage{% if block_settings.image_tilt != blank and block_settings.image_tilt != 0 %} image-block__photo-stage--tilted{% endif %}">
      <figure class="image-block__framed-photo{% if block_settings.white_border_width > 0 %} image-block__framed-photo--white{% endif %}">
        {{ single_image }}
        {% if block_settings.caption != blank %}<figcaption>{{ block_settings.caption | escape }}</figcaption>{% endif %}
      </figure>
    </div>
  {% else %}
    {{ single_image }}
  {% endif %}
  {% endif %}
{% endcapture %}

{% if block_settings.link == blank %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </div>
{% else %}
  <a
    href="{{ block_settings.link }}"
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </a>
{% endif %}

{% stylesheet %}
  .image-block__photo-stage {
    inline-size: 100%;
    min-inline-size: 0;
  }

  .image-block__photo-stage--tilted {
    /* Reserve space for the rotated corners within the image column. */
    padding: 14%;
  }

  .image-block__framed-photo {
    margin: 0;
    min-inline-size: 0;
    padding: var(--image-block-frame-width);
    border-radius: var(--image-block-frame-radius);
    transform: rotate(var(--image-block-tilt));
  }

  .image-block__framed-photo--white {
    background: #fff;
    color: inherit;
    box-shadow: var(--shadow-button);
  }

  .image-block__framed-photo figcaption {
    padding-block-start: var(--padding-sm);
    text-align: center;
    font-family: inherit;
    overflow-wrap: anywhere;
  }

  .image-block:has(.image-block__story-pair) {
    min-inline-size: 0;
  }

  .image-block__story-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--padding-4xl);
    inline-size: 100%;
    min-inline-size: 0;
    padding: 8% 5%;
  }

  .image-block__story-photo {
    margin: 0;
    min-inline-size: 0;
    padding: var(--padding-xs);
    background: var(--color-background);
    color: var(--color-foreground);
    border-radius: var(--border-radius-sm);
    box-shadow: var(--shadow-button);
    transform: rotate(-4deg);
  }

  .image-block__story-photo:nth-child(2) {
    transform: rotate(4deg);
  }

  .image-block__story-photo :is(img, svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    border-radius: var(--border-radius-sm);
  }

  .image-block__story-photo figcaption {
    padding-block: var(--padding-sm) var(--padding-xs);
    text-align: center;
    font-family: inherit;
    overflow-wrap: anywhere;
  }

  .image-block__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  .placeholder-image {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }

  .image-block {
    display: flex;

    /* When the image is nested in a group, section, etc, respect the parent's horizontal alignment */
    justify-content: var(--horizontal-alignment, 'inline-start');
  }

  .image-block--height-fill .image-block__image {
    height: 100%;
  }

  .image-block__image {
    object-fit: cover;
    aspect-ratio: var(--ratio);
  }

  @media screen and (min-width: 750px) {
    .image-block.image-block--pixel-height-desktop {
      height: auto;
    }

    .image-block--pixel-height-desktop :is(.image-block__image, .placeholder-image) {
      height: var(--image-block-height-desktop);
      aspect-ratio: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .image-block.image-block--pixel-height-mobile {
      height: auto;
    }

    .image-block--pixel-height-mobile :is(.image-block__image, .placeholder-image) {
      height: var(--image-block-height-mobile);
      aspect-ratio: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "checkbox",
      "id": "story_photo_pair",
      "label": "t:settings.story_photo_pair",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "second_image",
      "label": "t:settings.story_second_image",
      "visible_if": "{{ block.settings.story_photo_pair }}"
    },
    {
      "type": "image_picker",
      "id": "third_image",
      "label": "t:settings.story_third_image",
      "visible_if": "{{ block.settings.story_photo_pair }}"
    },
    {
      "type": "text",
      "id": "third_caption",
      "label": "t:settings.story_third_caption",
      "visible_if": "{{ block.settings.story_photo_pair }}"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:settings.story_first_caption"
    },
    {
      "type": "range",
      "id": "image_tilt",
      "label": "t:settings.story_image_tilt",
      "min": -15,
      "max": 15,
      "step": 1,
      "unit": "°",
      "default": 0,
      "visible_if": "{{ block.settings.story_photo_pair == false }}"
    },
    {
      "type": "range",
      "id": "white_border_width",
      "label": "t:settings.story_white_border_width",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.story_photo_pair == false }}"
    },
    {
      "type": "text",
      "id": "second_caption",
      "label": "t:settings.story_second_caption",
      "visible_if": "{{ block.settings.story_photo_pair }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "t:ps4.image_height_desktop",
      "info": "t:ps4.image_height_pixels_info",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.story_photo_pair == false }}"
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "t:ps4.image_height_mobile",
      "info": "t:ps4.image_height_pixels_info",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.story_photo_pair == false }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.image",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
